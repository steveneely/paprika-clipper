{
  "manifest_version": 3,
  "name": "Paprika Recipe Clipper (Unofficial)",
  "version": "1.0.1",
  "description": "Independent, unofficial extension for saving recipe pages to Paprika. Not affiliated with Paprika or Hindsight Labs.",
  "minimum_chrome_version": "120",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://www.paprikaapp.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Paprika Recipe Clipper \u2014 Unofficial",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_page": "popup.html#settings",
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      }
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.paprikaapp.com/bookmarklet/",
        "https://www.paprikaapp.com/bookmarklet"
      ],
      "js": [
        "connect.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src https://www.paprikaapp.com"
  },
  "homepage_url": "https://github.com/steveneely/paprika-clipper"
}
